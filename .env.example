# =============================================================================
#  건강 케어 챗봇 (Gradio + Hugging Face Spaces + Supabase) 환경변수 템플릿
# -----------------------------------------------------------------------------
#  사용 방법
#  1) 이 파일을 .env 로 복사한 뒤 값만 채운다.
#       Windows(PowerShell) :  Copy-Item .env.example .env
#       Mac / Linux         :  cp .env.example .env
#  2) .env 는 절대 GitHub에 올리지 않는다. (.gitignore 에 .env 가 이미 있다)
#  3) Hugging Face Spaces에서는 .env 파일을 올리지 않고,
#     Spaces → Settings → Variables and Secrets 에 아래 이름과 값을 그대로 등록한다.
#     (Space를 다시 시작해야 반영됩니다)
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Hugging Face
# -----------------------------------------------------------------------------
# huggingface.co 로그인 → 오른쪽 위 프로필 → Settings → Access Tokens
# → [New token] → Role: Read → 생성된 토큰을 아래에 붙여넣기 (hf_ 로 시작)
HF_TOKEN=hf_본인의_토큰

# 수업에서 사용할 한국어 의료 특화 모델 (snuh/hari-q2.5-thinking 권장)
HF_MODEL_ID=snuh/hari-q2.5-thinking

# -----------------------------------------------------------------------------
# 2) Supabase (Lovable Cloud)
# -----------------------------------------------------------------------------
# Supabase 프로젝트 → Connect / Project Settings → API 에서 확인
# 형식: https://<프로젝트참조>.supabase.co
SUPABASE_URL=https://mdrwnllpuowzkfdqkhpz.supabase.co

# Publishable key (sb_publishable_... 로 시작)
# 이 키는 브라우저에 공개되어도 되는 '공개용' 키입니다.
# 데이터 보호는 RLS(행 단위 보안) 정책이 담당합니다.
SUPABASE_KEY=sb_publishable_z7Ig5v5rp4KqitNlXIKJ-A_mpS5vdpP

# -----------------------------------------------------------------------------
# 3) 절대 .env 에 넣지 말 것
# -----------------------------------------------------------------------------
# - SUPABASE_SERVICE_ROLE_KEY (RLS를 우회하는 서버 관리 키. Lovable Cloud에서는 제공되지 않습니다)
# - Hugging Face Write 권한 토큰
# - Google / Kakao client secret
# - 개인 액세스 토큰 (sbp_ 로 시작)
# 위 값이 채팅·캡처·GitHub에 노출되면 즉시 키를 폐기(회전)하고 새로 발급받으세요.

# -----------------------------------------------------------------------------
# 4) 선택: 응급 상황 알림 기능
# -----------------------------------------------------------------------------
# off 로 두면 응급 키워드 감지 안내만 표시하고 실제 문자/알림 전송은 하지 않습니다.
# (수업 시연에는 off 권장)
EMERGENCY_BROADCAST=off

# 선생님(시연) 계정 이메일. 로그인하지 않고 시험할 때 사용할 대표 이메일.
DEMO_USER_EMAIL=teacher@example.com
